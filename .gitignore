.DS_Store

# Go build artifacts (the photon binary if built at the repo root, test bins, coverage profiles)
/photon
/photon.exe
*.test
*.out

# Release archives staged by a dist build — published as GitHub release assets, never committed
/dist/

# Rendered clips and takes from local runs; the shipped GIF lives in the project that films it
*.take

# Local cross-repo development against a sibling checkout
/go.work
/go.work.sum

# Machine-local agent instructions. CLAUDE.md only imports AGENTS.md, the shared guide
/CLAUDE.md
/CLAUDE.local.md
/AGENTS.local.md
