#!/usr/bin/env node
// Generated by cmd/release in airiclenz/photon: edit cmd/release/templates/npm/photon.js.tmpl there.
//
// The launcher {{.Wrapper}} installs as `photon`: it runs the binary from the platform
// package npm installed beside it as an optional dependency, passing the arguments and the
// terminal through, and exits with the binary's status.
"use strict";

const { spawnSync } = require("child_process");
const path = require("path");

const platformPackages = {
{{- range $index, $platform := .Platforms}}{{if $index}},{{end}}
  "{{$platform.OS}}-{{$platform.CPU}}": { name: "{{$platform.Name}}", binary: "{{$platform.Binary}}" }
{{- end}}
};

const platform = `${process.platform}-${process.arch}`;
const platformPackage = platformPackages[platform];
if (!platformPackage) {
  console.error(`photon: no photon binary is published for ${platform}`);
  process.exit(1);
}

let binary;
try {
  const manifest = require.resolve(`${platformPackage.name}/package.json`);
  binary = path.join(path.dirname(manifest), "bin", platformPackage.binary);
} catch (error) {
  console.error(
    `photon: the package ${platformPackage.name} is not installed; ` +
      "reinstall {{.Wrapper}} with optional dependencies enabled"
  );
  process.exit(1);
}

const result = spawnSync(binary, process.argv.slice(2), { stdio: "inherit" });
if (result.error) {
  console.error(`photon: run ${binary}: ${result.error.message}`);
  process.exit(1);
}
process.exit(result.status === null ? 1 : result.status);
