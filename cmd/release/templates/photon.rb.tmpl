# Generated by cmd/release in airiclenz/photon and overwritten at each release: edit
# cmd/release/templates/photon.rb.tmpl there, never this file.
class Photon < Formula
  desc "Record, check and render a terminal app's demo clip from its storyboard"
  homepage "https://github.com/airiclenz/photon"
  version "{{.Version}}"
  license "MIT"

  # `photon render` encodes the GIF with ffmpeg; gifsicle, which only shrinks it, stays optional.
  depends_on "ffmpeg"

  # Installs the prebuilt binary for this platform rather than compiling, so no Go
  # toolchain is needed. The tree is CGO-free, so all six release targets come off
  # one `cmd/release dist` in the project repo.
  on_macos do
    on_arm do
{{- with .Archive "darwin" "arm64"}}
      url "{{.URL}}"
      sha256 "{{.SHA256}}"
{{- end}}
    end
    on_intel do
{{- with .Archive "darwin" "amd64"}}
      url "{{.URL}}"
      sha256 "{{.SHA256}}"
{{- end}}
    end
  end

  on_linux do
    on_arm do
{{- with .Archive "linux" "arm64"}}
      url "{{.URL}}"
      sha256 "{{.SHA256}}"
{{- end}}
    end
    on_intel do
{{- with .Archive "linux" "amd64"}}
      url "{{.URL}}"
      sha256 "{{.SHA256}}"
{{- end}}
    end
  end

  def install
    bin.install "photon"
  end

  test do
    # `photon version` prints the bare version, X.Y.Z.
    assert_match version.to_s, shell_output("#{bin}/photon version")
  end
end
